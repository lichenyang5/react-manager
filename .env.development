# 当前项目运行模式（vite 会用它来区分 dev、build 等行为）
NODE_ENV=development

# ⛔ 注：
# 在 vite 项目中，其实更推荐用 vite 的 --mode 参数来区分环境，而不是 NODE_ENV。
# 但某些插件或工具（比如 eslint、webpack 风格代码）可能仍然会读取 NODE_ENV，所以保留也没问题。

# ✅ 接口前缀地址（开发/测试中会用于 axios baseURL）
VITE_BASE_API=/api
# ⛔ 说明：
# 这通常是为了方便做代理，比如你在 vite.config.ts 中设置：
#   proxy: { '/api': { target: 'http://真实后端地址', changeOrigin: true } }

# ✅ 上传接口的地址（比如用于图片上传）
VITE_UPLOAD_API=http://api-driver-dev.marsview.cc
# ⛔ 说明：
# 如果你的上传接口不走代理，而是走独立域名，就会用这个地址来上传文件。

# ✅ CDN 资源地址（图片、字体、视频等静态资源可能走 CDN 加速）
VITE_CDN=http://www.aliyun.com
# ⛔ 说明：
# 项目中可能有资源地址拼接为 `${VITE_CDN}/img/xxx.png`

# ✅ mock 数据开关（是否启用 mock）
VITE_MOCK=false
# ⛔ 说明：
# 用于本地开发时是否使用 mock 数据，适用于没有后端接口的时候
# 你可以在代码中用：
#   if (import.meta.env.VITE_MOCK === 'true') { ... }
# 后端接口没完成	自己造数据先把页面做出来
# 接口不稳定	模拟各种异常（比如 code = 500）测试容错
# 联调前先预览	把页面流程都走通，让后端照着数据结构来写

# ✅ mock 接口的基础地址（如果启用 mock，就请求这个地址）
VITE_MOCK_API=http://localhost:3000/mock
# ⛔ 说明：
# 你本地可能开了一个 mock 服务，比如使用 mockjs 或 miragejs，在这个地址返回假数据
